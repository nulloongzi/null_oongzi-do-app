# 로컬 빌드용 시크릿 템플릿.
#
# 사용법: 이 파일을 같은 디렉터리에 secrets.properties 로 복사하고 값을 채운다.
#   cp android/secrets.properties.example android/secrets.properties
#
# secrets.properties 는 .gitignore 에 있어 커밋되지 않는다. 이 저장소는 공개이므로
# 실제 값을 커밋하지 말 것. CI(GitHub Actions)는 리포지토리 시크릿에서 환경변수로 주입한다.

# 네이버 로그인 Client Secret — developers.naver.com > 내 애플리케이션 > 앱 > 개요
# (Client ID는 공개값이라 strings.xml 에 그대로 두었다)
naverClientSecret=
